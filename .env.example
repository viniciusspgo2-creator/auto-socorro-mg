# ============================================================
# Auto Socorro MG — Variáveis de ambiente
# Copie como .env (local) e cadastre na Vercel (produção)
# ============================================================

# OBRIGATÓRIA — Banco de dados PostgreSQL (Neon, Supabase ou Vercel Postgres)
# Exemplo Neon: postgresql://usuario:senha@ep-xxx-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# PAINEL ADMIN (/admin)
# Senha de acesso ao painel administrativo (troque em produção!)
ADMIN_PASSWORD="escolha-uma-senha-forte"
# Segredo usado para assinar o cookie de sessão do admin (texto aleatório longo)
SESSION_SECRET="gere-uma-string-aleatoria-longa-64-chars"

# OPCIONAL — URL pública do site (pode ser configurada no painel > SEO)
# NEXT_PUBLIC_SITE_URL="https://www.seudominio.com.br"

# OPCIONAL — Google (também podem ser configurados no painel > SEO)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# APENAS PARA DESENVOLVIMENTO LOCAL DO SANDBOX (ignorar em produção)
# LOCAL_PG_URL="postgresql://autosocorro_app:devlocal123@127.0.0.1:5432/autosocorro"
